-- Korean lives in its own file (Shared/LocaleKo) so translators never touch this one
Locale.ko = require(script.Parent.LocaleKo)

-- one game currency in every language
Locale.CURRENCY = "$"
local CURRENCY_ARGS = { money = true, price = true, value = true, lo = true, hi = true }

local function commas(n: number): string
	local s = tostring(math.abs(math.floor(n)))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return (if n < 0 then "-" else "") .. out
end

function Locale.money(n: number): string
	return Locale.CURRENCY .. commas(n)
end

function Locale.text(lang: string, key: string): string
	local t = Locale[lang]
	return (type(t) == "table" and t[key]) or Locale.en[key] or key
end

local function format(lang: string, key: string, args: { [string]: any }?, depth: number): string
	local s = Locale.text(lang, key)
	if not args then
		return s
	end
	return (s:gsub("{(%w+)}", function(name)
		local v = args[name]
		if v == nil then
			return "{" .. name .. "}"
		end
		if type(v) == "string" and v:sub(1, 1) == "@" then
			if depth < 1 then
				return format(lang, v:sub(2), args, depth + 1)
			end
			return Locale.text(lang, v:sub(2))
		end
		if type(v) == "number" and CURRENCY_ARGS[name] then
			return Locale.money(v)
		end
		return tostring(v)
	end))
end

-- Korean particles after a filled-in word ("{part}을(를)"): the one the last syllable takes (batchim or not)
local PARTICLES = { ["을(를)"] = { "을", "를" }, ["이(가)"] = { "이", "가" }, ["은(는)"] = { "은", "는" }, ["과(와)"] = { "과", "와" }, ["와(과)"] = { "과", "와" } }
local function particles(s: string): string
	local syl = "[\234-\237][\128-\191][\128-\191]"
	return (s:gsub("(" .. syl .. ")(" .. syl .. "%(" .. syl .. "%))", function(ch, p)
		local pair = PARTICLES[p]
		local c = utf8.codepoint(ch)
		if not pair or c < 0xAC00 or c > 0xD7A3 then
			return nil
		end
		return ch .. (if (c - 0xAC00) % 28 ~= 0 then pair[1] else pair[2])
	end))
end

function Locale.format(lang: string, key: string, args: { [string]: any }?): string
	local s = format(lang, key, args, 0)
	if lang == "ko" and args and s:find("(", 1, true) then
		s = particles(s)
	end
	return s
end

-- the player's language: "ko" for Korean Roblox, else "en"
function Locale.langOf(localeId: string?): string
	return if localeId and localeId:sub(1, 2) == "ko" then "ko" else "en"
end

-- On the server: tag a label / prompt with a key instead of text; each client rewrites it in its own language
-- (client Localizer). Prompts: field "ActionText" (default) or "ObjectText".
function Locale.tag(inst: Instance, key: string, args: { [string]: any }?, field: string?)
	local f = field or (if inst:IsA("ProximityPrompt") then "ActionText" else "Text")
	if f == "ObjectText" then
		-- (prompts show the action only — no "Lift: Ground" / "Driver's seat" line over it: main 10-21, too busy)
		inst:SetAttribute("Loc_ObjectText", nil)
		;(inst :: any).ObjectText = ""
		return
	end
	-- the English text first, the key after: each client's Localizer redoes the text when the key changes, so the
	-- key's change must land last (the other order showed "Close hood" in English after a hood opened — test 2 TOP4)
	;(inst :: any)[f] = Locale.format("en", key, args)
	inst:SetAttribute("LocArgs_" .. f, if args then HttpService:JSONEncode(args) else nil)
	inst:SetAttribute("Loc_" .. f, key)
end

function Locale.decodeArgs(json: string?): { [string]: any }?
	if not json or json == "" then
		return nil
	end
	local ok, res = pcall(HttpService.JSONDecode, HttpService, json)
	return if ok then res else nil
end

return Locale
